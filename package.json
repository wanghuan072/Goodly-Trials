{
  "name": "goodly-trials",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --hostname ::",
    "build": "vinext build && next typegen",
    "build:sites": "vinext build && next typegen",
    "build:next": "next build",
    "start": "vinext start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "verify": "npm run test && npm run lint && npm run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
